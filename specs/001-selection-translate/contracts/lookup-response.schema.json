{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LookupResult",
  "description": "硅基流动 LLM 查词结构化响应，经 zod 校验后用于弹框渲染",
  "type": "object",
  "required": ["word", "primaryMeaning", "definitions"],
  "properties": {
    "word": {
      "type": "string",
      "minLength": 1,
      "description": "查询词"
    },
    "phonetic": {
      "type": "string",
      "description": "IPA 音标，可选"
    },
    "primaryMeaning": {
      "type": "string",
      "minLength": 1,
      "description": "主要中文释义"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pos", "meanings"],
        "properties": {
          "pos": {
            "type": "string",
            "description": "词性缩写，如 n. v. adj. excl."
          },
          "meanings": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "example": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": {
              "en": { "type": "string" },
              "zh": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "word": "welcome",
      "phonetic": "/ˈwelkəm/",
      "primaryMeaning": "欢迎",
      "definitions": [
        {
          "pos": "excl.",
          "meanings": ["欢迎"],
          "example": {
            "en": "Welcome! Please come in.",
            "zh": "欢迎！请进。"
          }
        },
        {
          "pos": "v.",
          "meanings": ["欢迎", "欣然接受"],
          "example": {
            "en": "We welcome your feedback.",
            "zh": "我们欢迎您的反馈。"
          }
        }
      ]
    }
  ]
}
